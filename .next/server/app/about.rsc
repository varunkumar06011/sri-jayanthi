hildren":"Dr. [Founder Name]"}],["$","p",null,{"className":"text-sm text-gold font-medium mb-6","children":"BAMS, MD (Ayurveda) | Panchakarma Specialist"}],["$","div",null,{"className":"space-y-4 text-sm text-forest/70 leading-relaxed","children":[["$","p",null,{"children":"I have been practicing Ayurveda for over 15 years now. My training started in a traditional gurukul setting and was solidified by years of clinical work in both government hospitals and private practice."}],["$","p",null,{"children":"I specialize in Panchakarma and musculoskeletal disorders — mainly because I saw too many people suffering from back pain and being told surgery was the only option. It rarely is."}],["$","p",null,{"children":"My approach is conversational. I explain your condition, the treatment plan, and what you can realistically expect. No miracles. No guarantees. Just solid medicine applied with care."}]]}],["$","div",null,{"className":"mt-6 p-5 bg-gray-50 border-l-4 border-forest","children":["$","p",null,{"className":"text-base text-forest/90 leading-relaxed font-medium","children":"We don't just treat — we teach you to heal."}]}]]}]]}]}]}],["$","section",null,{"className":"py-12 md:py-16 border-t border-gray-100 bg-gray-50","children":["$","div",null,{"className":"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center","children":[["$","div",null,{"className":"flex justify-center mb-6","children":["$","img",null,{"src":"/Logo-Final-Version.png","alt":"","className":"w-20 h-auto opacity-40"}]}],["$","h2",null,{"className":"font-sans text-2xl md:text-3xl font-bold text-forest mb-4","children":"Our Mission"}],["$","p",null,{"className":"text-forest/70 leading-relaxed","children":"To make authentic Ayurvedic healthcare accessible, honest, and effective. We believe that true wellness comes from understanding your own body, not depending on a doctor forever. Our job is to guide you back to balance — and then teach you how to stay there."}]]}]}],["$","section",null,{"className":"py-12 md:py-16","children":["$","div",null,{"className":"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8","children":[["$","h2",null,{"className":"font-sans text-2xl font-bold text-forest mb-6","children":"How the Clinic Started"}],["$","div",null,{"className":"space-y-4 text-sm text-forest/70 leading-relaxed","children":[["$","p",null,{"children":"Sri Jayanthi began as a small consultation room in 2009. I had just completed my post-graduation and wanted a space where I could practice without rushing through patients."}],["$","p",null,{"children":"Word spread slowly. A farmer with chronic knee pain walked in, and walked out pain-free after two weeks. A teacher with psoriasis found relief after years of steroid creams. They told their families. Their families told others."}],["$","p",null,{"children":"Today we have a full Panchakarma unit, a pharmacy, and a team of therapists and assistants. But the core remains the same: one patient at a time, one honest conversation at a time."}]]}]]}]}],["$","section",null,{"className":"py-12 md:py-16 border-t border-gray-100 bg-gray-50","children":["$","div",null,{"className":"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8","children":[["$","h2",null,{"className":"font-sans text-2xl font-bold text-forest mb-8 text-center","children":"The Team"}],["$","div",null,{"className":"grid md:grid-cols-3 gap-6","children":[["$","div","0",{"className":"p-6 bg-white border border-gray-200 rounded-lg text-center","children":[["$","div",null,{"className":"w-16 h-16 rounded-full bg-forest/10 flex items-center justify-center mx-auto mb-4 text-forest font-sans font-bold text-xl","children":"A"}],["$","h3",null,{"className":"font-sans text-lg font-semibold text-forest mb-2","children":"Ayurvedic Doctor"}],["$","p",null,{"className":"text-sm text-forest/60","children":"Patient consultations, diagnosis, and treatment planning."}]]}],["$","div","1",{"className":"p-6 bg-white border border-gray-200 rounded-lg text-center","children":[["$","div",null,{"className":"w-16 h-16 r